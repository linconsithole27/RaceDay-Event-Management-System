            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateEnrolmentDto": {
        "required": [
          "categoryId",
          "participantId"
        ],
        "type": "object",
        "properties": {
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateEventDto": {
        "required": [
          "eventDate",
          "eventName",
          "location",
          "organiserId"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "minLength": 1,
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date"
          },
          "location": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "organiserId": {
            "type": "integer",
            "format": "int32"
          },
          "distance": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "eventType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateResultDto": {
        "required": [
          "enrolmentId",
          "finishTime",
          "position"
        ],
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "type": "string",
            "format": "time"
          },
          "position": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterOrganiserDto": {
        "required": [
          "organiserEmail",
          "organiserName",
          "password"
        ],
        "type": "object",
        "properties": {
          "organiserName": {
            "minLength": 1,
            "type": "string"
          },
          "organiserEmail": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterParticipantDto": {
        "required": [
          "participantEmail",
          "participantName",
          "password"
        ],
        "type": "object",
        "properties": {
          "participantName": {
            "minLength": 1,
            "type": "string"
          },
          "participantEmail": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
