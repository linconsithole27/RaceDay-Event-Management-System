@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Events</h2>
            <p class="text-muted">Manage the events you have created.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create New Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
            Click "Create New Event" to get started.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th>Event Type</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>

                            <td>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@item.Locationn</td>

                            <td>
                                @(item.Distance?.ToString() ?? "Not specified")
                            </td>

                            <td>
                                @(item.EventType ?? "Not specified")
                            </td>

                            <td>
                                @(item.Descriptionn ?? "No description")
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="OrganiserCategories"
                                       asp-action="Index"
                                       asp-route-eventId="@item.EventId"
                                       class="btn btn-sm btn-info">
                                        Categories
                                    </a>

                                    <form asp-controller="Organiser"
                                          asp-action="DeleteEvent"
                                          asp-route-id="@item.EventId"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>

                
