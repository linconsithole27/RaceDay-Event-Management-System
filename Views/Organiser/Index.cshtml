@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h1>Organiser Dashboard</h1>
    <p class="text-muted">Welcome to your RaceDay management dashboard.</p>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>My Events</h5>
                    <p>Manage your running events.</p>
                    <a asp-controller="Organiser" asp-action="Events"
                       class="btn btn-primary">Manage Events</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Categories</h5>
                    <p>Manage event categories.</p>
                    <a asp-controller="Organiser" asp-action="Categories"
                       class="btn btn-primary">Manage Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Results</h5>
                    <p>Capture and publish race results.</p>
                    <a asp-controller="Organiser" asp-action="Results"
                       class="btn btn-primary">Manage Results</a>
                </div>
            </div>
        </div>
    </div>

    <a asp-controller="Account" asp-action="Logout"
       class="btn btn-danger mt-3">Logout</a>
</div>

